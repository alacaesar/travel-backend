{
    "kind": "collectionType",
    "collectionName": "travel_entries",
    "info": {
        "singularName": "travel-entry",
        "pluralName": "travel-entries",
        "displayName": "Travel Entry",
        "description": "A specific activity or event during a journey"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "title": {
            "type": "string",
            "required": true
        },
        "slug": {
            "type": "uid",
            "targetField": "title"
        },
        "description": {
            "type": "text",
            "maxLength": 300
        },
        "coverImage": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "images"
            ]
        },
        "date": {
            "type": "date"
        },
        "category": {
            "type": "enumeration",
            "enum": [
                "Adventure",
                "Relaxed",
                "Cultural",
                "Food",
                "Nature"
            ]
        },
        "content": {
            "type": "blocks"
        },
        "country": {
            "type": "relation",
            "relation": "oneToOne",
            "target": "api::country.country"
        },
        "location": {
            "type": "customField",
            "customField": "plugin::strapi-location-picker.location-picker",
            "options": {
                "info": true
            }
        },
        "journeys": {
            "type": "relation",
            "relation": "manyToMany",
            "target": "api::journey.journey",
            "mappedBy": "travel_entries"
        }
    }
}
