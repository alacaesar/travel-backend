# Copy to .env on the server (never commit .env).

# Image from GitHub Actions (GHCR), e.g. ghcr.io/your-user/your-repo:latest
STRAPI_IMAGE=

NODE_ENV=production
HOST=0.0.0.0
PORT=1337

# Public URL of this Strapi instance (used in admin + absolute media URLs).
PUBLIC_URL=https://api.example.com

# Comma-separated browser origins allowed to call the API (Vercel production + previews).
# Example: https://your-app.vercel.app,https://www.example.com
STRAPI_ALLOWED_ORIGINS=https://www.example.com

# Strapi secrets — generate new random strings for production.
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=

# SQLite (default). DB file lives under .tmp/ — mount a Docker volume on .tmp.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
